{
    "name": "helsingborg-stad/custom-short-links",
    "description": "Create shortlinks for any type of content",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Kristoffer Svanmark",
            "email": "kristoffer.svanmark@lexiconitkonsult.se"
        }
    ],
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit",
        "lint": "vendor/bin/mago lint",
        "fix": "vendor/bin/mago lint --format-after-fix --fix",
        "format": "vendor/bin/mago fmt"
    },
    "autoload": {
        "psr-4": {
            "CustomShortLinks\\": "source/php/"
        }
    },
    "require": {
        "helsingborg-stad/wputilservice": "^0.3",
        "helsingborg-stad/wpservice": "^2.0"
    },
    "suggest": {
        "helsingborg-stad/municipio": "^6.0.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "carthage-software/mago": "^1.0.0-rc.3"
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true
        }
    }
}